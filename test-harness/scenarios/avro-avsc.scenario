====test====
Lint an Avro schema (.avsc) with the built-in Avro ruleset
====asset:user.avsc====
{
  "type": "record",
  "name": "User",
  "namespace": "com.example",
  "fields": [
    { "name": "id", "type": { "type": "string", "logicalType": "uuid" } },
    { "name": "age", "type": "int", "default": "unknown" },
    { "name": "email", "type": ["string", "null"] },
    { "name": "address", "type": "Address" },
    { "name": "status", "type": { "type": "enum", "name": "Status", "symbols": ["ACTIVE", "ACTIVE"] } },
    { "name": "createdAt", "type": { "type": "int", "logicalType": "timestamp-millis" } }
  ]
}
====asset:ruleset====
const { avro } = require('@stoplight/spectral-rulesets');
module.exports = avro;
====command====
{bin} lint {asset:user.avsc} --ruleset "{asset:ruleset}"
====status====
1
