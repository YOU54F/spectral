====test====
Validate an A2A 1.0 Agent Card with the spectral:a2a ruleset
====document====
name: Recipe Agent
description: Finds and plans recipes.
version: 1.0.0
supportedInterfaces:
  - url: https://agent.example.com/a2a/v1
    protocolBinding: JSONRPC
    protocolVersion: "1.0"
  - url: http://agent.example.com/a2a/rest
    protocolBinding: HTTP+JSON
    protocolVersion: "1.0.1"
provider:
  organization: Example Org
  url: https://example.com
capabilities:
  streaming: true
securitySchemes:
  bearer:
    httpAuthSecurityScheme:
      scheme: Bearer
securityRequirements:
  - schemes:
      oauth:
        list:
          - recipes.read
defaultInputModes:
  - text/plain
defaultOutputModes:
  - text/plain
  - application/json
skills:
  - id: recipe-search
    name: Recipe search
    description: Finds recipes by ingredient or cuisine.
    tags:
      - cooking
    examples:
      - Find me a vegetarian lasagne recipe
  - id: recipe-search
    name: Meal planner
    description: Plans a week of meals.
    tags:
      - cooking
    examples:
      - Plan five dinners under 30 minutes
====asset:ruleset====
const { a2a } = require('@stoplight/spectral-rulesets');
module.exports = a2a;
====command====
{bin} lint {document} --ruleset "{asset:ruleset}"
====status====
1
====stdout====
